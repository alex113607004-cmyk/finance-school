{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-school",
  "main": "worker/cloud-app.mjs",
  "compatibility_date": "2026-11-20",
  "build": {"command": "npm run build:cloud"},
  "workers_dev": true,
  "keep_vars": true,
  "durable_objects": {"bindings": [{"name": "WATCHLISTS", "class_name": "WatchlistStorage"}]},
  "migrations": [{"tag": "watchlist-v1", "new_sqlite_classes": ["WatchlistStorage"]}]
}
