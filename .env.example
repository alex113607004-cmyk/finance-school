# Optional official REST data backend; leave empty for static GitHub Pages.
# No API keys belong in any VITE_* variable (they are public build output).
VITE_MARKET_API_ORIGIN=
# Optional separate intraday backend origin. This URL is public; never put keys here.
VITE_INTRADAY_API_ORIGIN=
# Server-only settings for worker/intraday.mjs; configure secrets at backend host.
# FUGLE_API_KEY=
# INTRADAY_ALLOWED_ORIGIN=https://alex113607004-cmyk.github.io
# INTRADAY_PUBLIC_DISPLAY_CONFIRMED=false
# INTRADAY_LICENSE_URL=
# Live streaming remains unconnected. The optional minute snapshot adapter is
# described in docs/WATCHLIST-INTRADAY.md; streaming plans in docs/REALTIME.md.
# FUGLE_API_KEY=<backend secret manager only>

# Server / Actions only. Never prefix these variables with VITE_.
# SEC requires an identifiable project and contact; use an Actions Secret or variable.
SEC_UPDATES_ENABLED=false
SEC_USER_AGENT=
# Without SEC_USER_AGENT, SEC requests are disabled; no contact is inferred.
# Missing identity or upstream failure keeps original verified snapshots and dates.
# Optional licensed provider contract; see docs/TW-US-ANALYSIS.md.
US_PUBLIC_QUOTE_FILE=
US_PUBLIC_DISPLAY_CONFIRMED=false

# Existing loopback twstock snapshot service (development only).
VITE_TWSTOCK_LOCAL=0

# Optional Alpaca integration carried forward from main; backend only.
US_PUBLISH_MARKET_DATA=0
US_ALPACA_FEED=sip
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
US_MARKET_DATA_LICENSE_URL=
US_MARKET_DATA_LICENSE_CHECKED_AT=
US_MARKET_DATA_CACHE_POLICY=
