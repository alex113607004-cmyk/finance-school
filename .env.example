# Optional official REST data backend; leave empty for static GitHub Pages.
# No API keys belong in any VITE_* variable (they are public build output).
VITE_MARKET_API_ORIGIN=
# Fugle is not connected in this post-market version. Future server-only settings
# and snapshot/stream integration are described in docs/REALTIME.md.
# FUGLE_API_KEY=<backend secret manager only>

# Server / Actions only. Never prefix these variables with VITE_.
# SEC requires an identifiable project and contact; use an Actions Secret or variable.
SEC_USER_AGENT=
# Without SEC_USER_AGENT, SEC requests are disabled; no contact is inferred.
# Missing identity or upstream failure keeps original verified snapshots and dates.
# Optional licensed provider contract; see docs/TW-US-ANALYSIS.md.
US_PUBLIC_QUOTE_FILE=
US_PUBLIC_DISPLAY_CONFIRMED=false
